# Frontend
VITE_API_BASE_URL=http://localhost:3001

# AI Provider: 'openai' (default) or 'claude'
AI_PROVIDER=openai
VITE_AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key

# Anthropic / Claude (used when AI_PROVIDER=claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase (optional local or cloud)
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (for local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/claimpilot
